    "/api/status": {
      "get": {
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "enum": [
                        "live",
                        "mock"
                      ]
                    },
                    "checkedAt": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sources": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "checkedAt": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "latencyMs": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "sourceTime": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "ageSeconds": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "state": {
                            "enum": [
                              "healthy",
                              "reachable",
                              "delayed",
                              "unavailable"
                            ]
                          },
                          "error": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "url",
                          "checkedAt",
                          "latencyMs",
                          "sourceTime",
                          "ageSeconds",
                          "state",
                          "error"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "mode",
                    "checkedAt",
                    "sources"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
