    "/api/auth/sync": {
      "get": {
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revision",
                    "updated",
                    "state"
                  ],
                  "properties": {
                    "revision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "updated": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "state": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "preferences",
                            "favorites"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "preferences": {
                              "type": "object",
                              "required": [
                                "lang",
                                "theme",
                                "font",
                                "motion",
                                "auto",
                                "lowData"
                              ],
                              "properties": {
                                "lang": {
                                  "enum": [
                                    "ar",
                                    "en"
                                  ]
                                },
                                "theme": {
                                  "enum": [
                                    "dark",
                                    "light"
                                  ]
                                },
                                "font": {
                                  "enum": [
                                    "standard",
                                    "large"
                                  ]
                                },
                                "motion": {
                                  "enum": [
                                    "system",
                                    "reduced"
                                  ]
                                },
                                "auto": {
                                  "type": "boolean"
                                },
                                "lowData": {
                                  "type": "boolean"
                                }
                              },
                              "additionalProperties": false
                            },
                            "favorites": {
                              "type": "array",
                              "maxItems": 12,
                              "items": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "lat",
                                  "lon"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  "lat": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                  },
                                  "lon": {
                                    "type": "number",
                                    "minimum": -180,
                                    "maximum": 180
                                  }
                                },
                                "additionalProperties": false
                              }
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
