    "@capacitor/core": "8.6.3",
    "@capacitor/geolocation": "8.2.6",
    "cesium": "1.147.0",
    "maplibre-gl": "6.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "vite": "8.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
