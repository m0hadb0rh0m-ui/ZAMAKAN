PORT=4173
HOST=127.0.0.1
# Never place secrets in VITE_* variables; browser public keys only.
# Optional: only an approved, restricted CLIENT/PUBLIC MapTiler key. No secrets here.
# MapTiler modes and commercial geocoder stay disabled while empty.
VITE_MAPTILER_PUBLIC_KEY=

# Build-only profile, set commercial exclusively in the owner-approved release workflow.
VITE_RELEASE_MODE=preview
VITE_CESIUM_PUBLIC_TOKEN=
VITE_WEATHER_API_BASE=
# On the production Node gateway ONLY (not VITE_*):
# OPEN_METEO_COMMERCIAL_KEY=
# WEATHER_ALLOWED_ORIGINS=https://localhost,https://your-app-domain.example
# WEATHER_PUBLIC_BASE=https://your-app-domain.example/api/weather
# WEATHER_DAILY_BUDGET=1000
# WEATHER_MINUTE_BUDGET=100
