PORT=4173
HOST=127.0.0.1
# Frontend build: only the owner-controlled public HTTPS server URL (NOT a key).
VITE_RELEASE_MODE=preview
VITE_BACKEND_URL=
# Server environment only; set these on the deployed backend, never in Git.
# MapTiler and Cesium are *restricted public read-only client* credentials.
# They are delivered at runtime, not embedded in the APK, and remain inspectable
# in network traffic. Never use admin/service/write credentials here.
MAPTILER_PUBLIC_KEY=
CESIUM_PUBLIC_TOKEN=
# Secret commercial weather key (NOT sent to clients):
OPEN_METEO_COMMERCIAL_KEY=
CLIENT_CONFIG_ALLOWED_ORIGINS=https://localhost,https://your-app-domain.example
WEATHER_ALLOWED_ORIGINS=https://localhost,https://your-app-domain.example
WEATHER_PUBLIC_BASE=https://your-app-domain.example/api/weather
CLIENT_CONFIG_PUBLIC_URL=https://your-app-domain.example/api/client-config
WEATHER_DAILY_BUDGET=1000
WEATHER_MINUTE_BUDGET=100

# Keyless independent data source. Set to a private directory containing verified
# model snapshots generated by scripts/update-weather.sh. Overrides paid gateway.
WEATHER_DATA_DIR=
