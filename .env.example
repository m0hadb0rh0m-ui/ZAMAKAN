PORT=4173
HOST=127.0.0.1
# Never place secrets in VITE_* variables; browser public keys only.
# Optional: only an approved, restricted CLIENT/PUBLIC MapTiler key. No secrets here.
# MapTiler modes and commercial geocoder stay disabled while empty.
VITE_MAPTILER_PUBLIC_KEY=

# Build-only profile, set commercial exclusively in the owner-approved release workflow.
VITE_RELEASE_MODE=preview
VITE_CESIUM_PUBLIC_TOKEN=
VITE_WEATHER_API_BASE=
# On the production Node gateway ONLY (not VITE_*):
# OPEN_METEO_COMMERCIAL_KEY=
# WEATHER_ALLOWED_ORIGINS=https://localhost,https://your-app-domain.example
# WEATHER_PUBLIC_BASE=https://your-app-domain.example/api/weather
# WEATHER_DAILY_BUDGET=1000
# WEATHER_MINUTE_BUDGET=100

# Production backend origin, public URL only (used by Android app).
VITE_ZAMAKAN_API_BASE=
# Server-only trusted CORS origins; include Android Capacitor origin.
ZAMAKAN_ALLOWED_ORIGINS=https://localhost
ZAMAKAN_PUBLIC_BASE=
# Persistent writable volume, used by OSM worker and server.
OSM_LIVE_FILE=./data/osm-live.json
# PRIME requires all of these on the SERVER, never VITE_* or in APK.
FIREBASE_WEB_API_KEY=
PRIME_DB_PATH=./data/prime.sqlite
PRIME_TOKEN_ENCRYPTION_KEY=
# Set GOOGLE_CLOUD_ADC=true on Google Cloud with least-privilege Play access,
# or mount GOOGLE_SERVICE_ACCOUNT_JSON through a secret manager.
GOOGLE_CLOUD_ADC=
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_MODEL=
PRIME_AI_DAILY_LIMIT=3
# Optional real OSM replicated polygon vector tiles from Martin, only after DB setup.
VITE_LIVE_BUILDINGS_BASE=
LIVE_BUILDINGS_PUBLIC_BASE=
PRIME_AI_GLOBAL_DAILY_LIMIT=30
# Authenticated Pub/Sub push, optional until configured. Audience is exact HTTPS webhook URL.
PRIME_RTDN_AUDIENCE=
PRIME_RTDN_SERVICE_ACCOUNT=
